# NimbusCMS environment. Copy to .env and adjust.
APP_NAME="NimbusCMS"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8080
# 32-byte base64 key; generate with: php bin/nimbus key:generate
APP_KEY=

DB_HOST=db
DB_PORT=3306
DB_NAME=nimbus
DB_USER=nimbus
DB_PASS=nimbus

# Addresses allowed to set X-Forwarded-For / X-Forwarded-Proto, comma separated.
# Leave EMPTY unless NimbusCMS sits behind a proxy you control — forwarded
# headers are ignored entirely when this is blank, because anyone can send them.
# Accepts plain IPs and CIDR blocks, e.g. the Docker bridge: 172.16.0.0/12
TRUSTED_PROXIES=

# where uploaded media is stored (under the web root so it's served directly)
UPLOAD_DIR=public/uploads
UPLOAD_URL=/uploads

# Seconds to cache rendered public pages. 0 (default) disables page caching.
# A positive value also bounds how long a scheduled entry can wait to appear.
PAGE_CACHE_TTL=0

# --- Outgoing mail (password reset) ---
# Transport: log (default — writes to storage/mail/mail.log, no delivery, ideal
# for dev/CI), native (PHP mail()/sendmail; needs a host MTA), or api (a
# transactional provider's HTTPS API — the simplest real delivery: one key).
MAIL_TRANSPORT=log
# From address for outgoing mail (defaults to no-reply@<your APP_URL host>).
MAIL_FROM=
# For MAIL_TRANSPORT=api: a bearer API key (a secret — never logged) and the
# provider endpoint. The default is Resend-compatible: a POST of
# {from,to,subject,text}. Point it at any provider of that shape.
MAIL_API_KEY=
MAIL_API_ENDPOINT=https://api.resend.com/emails

# --- SSO / "Sign in with…" (ADR 0012) ---
# Optional and OFF by default: with no credentials below, no provider buttons
# appear and password sign-in is the only method. A provider turns on only when
# BOTH its client id and secret are set. The secret is a secret — never logged
# or rendered in a page. Register the callback URL with each provider as
# <APP_URL>/admin/oauth/<provider>/callback (so APP_URL above must be correct).
# Phase 1 only signs in an already-linked identity and lets a logged-in user
# link a provider from Settings; it never creates accounts.
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_GITHUB_CLIENT_ID=
OAUTH_GITHUB_CLIENT_SECRET=

# --- Headless API hardening ---
# Per-token request quota within the window (0 disables the token quota).
API_RATE_LIMIT=120
# Per-IP flood ceiling within the window; catches no-token / invalid-token
# floods before authentication (0 disables).
API_FLOOD_LIMIT=300
# The rate-limit window, in seconds.
API_RATE_WINDOW=60
# CORS allow-list for /api/v1 — comma-separated origins, or * for any. Empty
# (default) means same-origin only and no Access-Control-* headers.
CORS_ALLOWED_ORIGINS=
