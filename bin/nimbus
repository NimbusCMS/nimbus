#!/usr/bin/env php
<?php

declare(strict_types=1);

require dirname(__DIR__) . '/bootstrap.php';

use Nimbus\Auth\Password;
use Nimbus\Database\Connection;
use Nimbus\Database\Migrator;
use Nimbus\Mail\MailerException;
use Nimbus\Mail\MailerFactory;
use Nimbus\Support\Config;
use Nimbus\Support\Env;

Env::load(Config::basePath() . '/.env');

$db          = new Connection(Config::db());
$migrations  = dirname(__DIR__) . '/src/Database/migrations';
$command     = $argv[1] ?? 'help';

/** Read a --name=value option from argv. */
$opt = static function (array $argv, string $name, ?string $default = null): ?string {
    foreach ($argv as $arg) {
        if (str_starts_with($arg, "--{$name}=")) {
            return substr($arg, strlen("--{$name}="));
        }
    }
    return $default;
};

$now = date('Y-m-d H:i:s');

/**
 * Print any plugin-migration failures to STDERR and exit non-zero, so a deploy or
 * CI notices a wedged plugin. Stdout stays the clean applied-names line. A core
 * failure never reaches here — it throws {@see Nimbus\Database\MigrationFailed}.
 */
$reportMigrationFailures = static function (Nimbus\Database\MigrationReport $report): void {
    if ($report->ok()) {
        return;
    }
    foreach ($report->failures as $failure) {
        fwrite(STDERR, "Plugin migration failed: {$failure['provider']} · {$failure['migration']} · {$failure['error']}\n");
    }
    fwrite(STDERR, "Other providers and core migrated; fix the plugin's DDL (make each statement idempotent) and re-run.\n");
    exit(1);
};

/**
 * Boot the application so enabled plugins declare their migrations, then hand
 * that registry to the Migrator. Booting touches no database, so it is safe on
 * a fresh, unmigrated install.
 */
$pluginMigrations = static fn (): Nimbus\Database\MigrationRegistry => (new Nimbus\Application($db))->migrationRegistry();

try {
    switch ($command) {
        case 'migrate':
            $report = (new Migrator($db, $migrations, $pluginMigrations()))->migrate();
            echo $report->applied === [] ? "Nothing to migrate.\n" : 'Migrated: ' . implode(', ', $report->applied) . "\n";
            $reportMigrationFailures($report); // stderr + exit non-zero if any plugin migration failed
            break;

        case 'install':
            $report = (new Migrator($db, $migrations, $pluginMigrations()))->migrate();
            $ran    = $report->applied;
            echo $ran === [] ? "Schema already present.\n" : 'Schema conjured (' . count($ran) . " migration(s)).\n";
            // A core failure would have thrown before here; a failed PLUGIN migration
            // must NOT block seeding (you need an admin to log in and fix it) — its
            // failures are reported at the end, after the admin + roles exist.

            $isDev = in_array(getenv('APP_ENV') ?: 'production', ['local', 'dev', 'development'], true);
            $email    = $opt($argv, 'email', $isDev ? 'admin@nimbus.test' : null);
            $name     = $opt($argv, 'name', 'Administrator');
            $password = $opt($argv, 'password');

            // Outside dev, refuse to seed weak/default credentials.
            if (!$isDev) {
                if ($email === null || $password === null) {
                    fwrite(STDERR, "Refusing to install outside dev without --email and --password. (Set APP_ENV=local for a demo default.)\n");
                    exit(1);
                }
                if (Password::isWeak($password)) {
                    fwrite(STDERR, 'Refusing a weak admin password. Use at least ' . Password::MIN_LENGTH . " non-default characters.\n");
                    exit(1);
                }
            }
            $password ??= 'password'; // dev-only default

            if ($db->selectOne('SELECT id FROM nb_users WHERE email = :e', ['e' => $email]) !== null) {
                echo "User {$email} already exists — skipping.\n";
            } else {
                $db->execute(
                    'INSERT INTO nb_users (name, email, password, role, created_at, updated_at) VALUES (:n, :e, :p, :r, :c, :u)',
                    ['n' => $name, 'e' => $email, 'p' => Password::hash((string) $password), 'r' => 'admin', 'c' => $now, 'u' => $now]
                );
                echo "Created admin  →  {$email} / {$password}\n";
            }

            // Seed roles after users exist, so each is assigned its system role (ADR 0011).
            $seeded = (new Nimbus\Auth\RoleSeeder($db, new Nimbus\Auth\RoleRepository($db), new Nimbus\Content\CollectionRepository($db)))->seed();
            echo "Roles: {$seeded} system role(s) seeded.\n";
            // Now that the install is usable, surface any plugin-migration failures
            // and exit non-zero so a deploy notices (the admin can still log in).
            $reportMigrationFailures($report);
            break;

        case 'roles:seed':
            // Idempotent: seed the system roles + assign users (also for an upgrade
            // of an existing install). Existing (possibly admin-edited) roles are
            // left untouched.
            $seeded = (new Nimbus\Auth\RoleSeeder($db, new Nimbus\Auth\RoleRepository($db), new Nimbus\Content\CollectionRepository($db)))->seed();
            echo "Roles: {$seeded} system role(s) seeded; users assigned.\n";
            break;

        case 'mail:test':
            $to = $argv[2] ?? null;
            if ($to === null || filter_var($to, FILTER_VALIDATE_EMAIL) === false) {
                fwrite(STDERR, "Usage: nimbus mail:test <address>\n");
                exit(1);
            }
            // Print the transport that will actually be used (the fallback shows
            // when MAIL_TRANSPORT is a typo) — the only way to verify api/native
            // config without locking yourself out via a real reset.
            $configured = Config::mailTransport();
            $resolved   = MailerFactory::resolvedTransport();
            echo $resolved === $configured
                ? "Transport: {$resolved}\n"
                : "Transport: {$resolved}  (fallback — MAIL_TRANSPORT=\"{$configured}\" is not one of native|api|log)\n";
            try {
                MailerFactory::fromConfig()->send(
                    $to,
                    'Nimbus test email',
                    "This is a test message from `nimbus mail:test`.\nIf you received it, your mail transport is working.",
                );
                echo "Sent to {$to}." . ($resolved === 'log' ? " (log transport — check " . Config::mailLogPath() . ", nothing was delivered)\n" : "\n");
            } catch (MailerException $e) {
                fwrite(STDERR, "Send failed: {$e->getMessage()}\n");
                exit(1);
            }
            break;

        case 'create-user':
            $email = $opt($argv, 'email');
            if ($email === null) {
                fwrite(STDERR, "Usage: nimbus create-user --email=you@example.com [--password= --name= --role=]\n");
                exit(1);
            }
            $db->execute(
                'INSERT INTO nb_users (name, email, password, role, created_at, updated_at) VALUES (:n, :e, :p, :r, :c, :u)',
                [
                    'n' => $opt($argv, 'name', 'User'),
                    'e' => $email,
                    'p' => Password::hash((string) $opt($argv, 'password', 'password')),
                    'r' => $opt($argv, 'role', 'editor'),
                    'c' => $now, 'u' => $now,
                ]
            );
            echo "Created user  →  {$email}\n";
            break;

        case 'token:create':
            $name = $opt($argv, 'name');
            if ($name === null) {
                fwrite(STDERR, "Usage: nimbus token:create --name=\"My app\" [--expires=90d|12h|2026-12-31]\n");
                exit(1);
            }
            $expiresAt = null;
            $expiresIn = $opt($argv, 'expires');
            if ($expiresIn !== null) {
                // `90d`/`12h` become a relative expression; anything else is
                // parsed as-is. One strtotime + one false-guard for both.
                $relative = preg_match('/^(\d+)([dh])$/', $expiresIn, $m) === 1
                    ? "+{$m[1]} " . ($m[2] === 'h' ? 'hours' : 'days')
                    : $expiresIn;
                $ts = strtotime($relative);
                if ($ts === false) {
                    fwrite(STDERR, "Could not read --expires=\"{$expiresIn}\" (use e.g. 90d, 12h, or 2026-12-31).\n");
                    exit(1);
                }
                $expiresAt = date('Y-m-d H:i:s', $ts);
            }
            $scopes    = [];
            $scopesOpt = $opt($argv, 'scopes');
            if ($scopesOpt !== null && trim($scopesOpt) !== '') {
                foreach (explode(',', $scopesOpt) as $scope) {
                    $scope = trim($scope);
                    // `admin` is the bare super-grant; every other scope is
                    // `resource:action` — a collection handle or a management
                    // capability (schema/media/users/tokens/settings) or `*`.
                    if ($scope !== 'admin' && preg_match('/^(\*|[a-z0-9-]+):(read|write)$/', $scope) !== 1) {
                        fwrite(STDERR, "Invalid scope \"{$scope}\" (use e.g. posts:read, schema:write, *:read, or admin).\n");
                        exit(1);
                    }
                    $scopes[] = $scope;
                }
            }
            // Optionally bind the token to a role — its capabilities are then the
            // role's, resolved live (ADR 0011). The CLI is a trusted operator, so
            // no subset-only check here; the role just has to exist.
            $roleId    = null;
            $roleLabel = '';
            $roleName  = $opt($argv, 'role');
            if ($roleName !== null && trim($roleName) !== '') {
                $role = (new Nimbus\Auth\RoleRepository($db))->findByName(trim($roleName));
                if ($role === null) {
                    fwrite(STDERR, "No role named \"{$roleName}\".\n");
                    exit(1);
                }
                $roleId    = $role->id;
                $roleLabel = " as role \"{$role->name}\"";
            }

            $plain = (new Nimbus\Api\ApiTokenRepository($db))->create($name, $scopes, $expiresAt, $roleId);
            echo "API token created: {$name}" . $roleLabel
                . ($scopes !== [] ? ' [' . implode(', ', $scopes) . ']' : ($roleId === null ? ' (no scopes — denies everything until granted)' : ''))
                . ($expiresAt !== null ? " (expires {$expiresAt})" : '') . "\n";
            echo "  {$plain}\n";
            echo "This is shown once. Store it now — only its hash is kept.\n";
            break;

        case 'openapi':
            $app        = new Nimbus\Application($db);
            $collections = new Nimbus\Content\CollectionRepository($db);
            $generator  = new Nimbus\Api\OpenApiGenerator($collections, $app->fieldTypeRegistry(), $app->settings()->title());
            echo json_encode($generator->generateFull(), JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES | JSON_THROW_ON_ERROR) . "\n";
            break;

        case 'mcp':
            // The MCP stdio transport (ADR 0009): JSON-RPC over stdin/stdout for a
            // local desktop client. It still runs as a *scoped token* — resolved
            // from NIMBUS_MCP_TOKEN exactly as the HTTP bearer path resolves one,
            // so a stdio session is capability-scoped, never raw DB access.
            //
            // stdout carries ONLY the JSON-RPC stream: pin PHP errors to stderr so
            // a stray warning can never corrupt a client's message framing.
            ini_set('display_errors', 'stderr');
            $plain = (string) Env::get('NIMBUS_MCP_TOKEN', '');
            if ($plain === '') {
                fwrite(STDERR, "nimbus mcp needs a scoped token in NIMBUS_MCP_TOKEN.\n");
                exit(1);
            }
            $tokens = new Nimbus\Api\ApiTokenRepository($db);
            $token  = $tokens->findByPlaintext($plain);
            if ($token === null) {
                fwrite(STDERR, "NIMBUS_MCP_TOKEN is not valid (unknown, revoked, expired, or paused).\n");
                exit(1);
            }
            $tokens->touch($token->id, 'stdio');

            $app         = new Nimbus\Application($db);
            $collections = new Nimbus\Content\CollectionRepository($db);
            $ops         = new Nimbus\Api\EntryOperations($db, $app->fieldTypeRegistry(), $app->events());
            $mediaRepo   = new Nimbus\Media\MediaRepository($db);
            $mediaUsage  = new Nimbus\Media\MediaUsageRepository($db);
            $uploader    = new Nimbus\Media\MediaUploader($mediaRepo, Config::uploadPath(), Config::uploadUrl(), Config::uploadMaxBytes(), static fn (string $from, string $to): bool => copy($from, $to));
            $settingsRegistry = new Nimbus\Settings\SettingsRegistry($collections);
            $settings         = $app->settings();
            $server = new Nimbus\Mcp\McpServer(
                new Nimbus\Mcp\SchemaToolset($collections, new Nimbus\Content\CollectionService($db, $collections), $app->fieldTypeRegistry(), $app->events()),
                new Nimbus\Mcp\MediaToolset($mediaRepo, $uploader, new Nimbus\Media\MediaService($mediaRepo, $mediaUsage, Config::basePath()), $mediaUsage, $app->events()),
                new Nimbus\Mcp\UsersToolset(new Nimbus\Auth\UserRepository($db), new Nimbus\Auth\RoleRepository($db), $db, $app->events()),
                new Nimbus\Mcp\TokensToolset(new Nimbus\Api\ApiTokenRepository($db), new Nimbus\Auth\RoleRepository($db), $app->events()),
                new Nimbus\Mcp\SettingsToolset($settings, $settingsRegistry, $app->events()),
                new Nimbus\Mcp\ContentToolset($collections, $app->fieldTypeRegistry(), $ops),
            );
            $transport = new Nimbus\Mcp\StdioTransport(
                $server,
                $tokens->principalFor($token),
                new Nimbus\Api\EntryOpContext('stdio', 'mcp'),
            );
            $transport->run(STDIN, STDOUT);
            break;

        case 'media:reindex':
            // Backfill the media-usage index from existing entries (one-off on
            // upgrade; new writes stay current on their own via EntryService).
            $collections = new Nimbus\Content\CollectionRepository($db);
            $reindexer   = new Nimbus\Media\MediaUsageReindexer($db, $collections, new Nimbus\Media\MediaUsageRepository($db));
            $scanned     = $reindexer->reindex();
            echo "Reindexed media usage across {$scanned} entr" . ($scanned === 1 ? 'y' : 'ies') . ".\n";
            break;

        case 'prune':
            // Core's own housekeeping: rate-limit rows for windows that rolled
            // over more than a day ago are dead weight.
            $removed = (new Nimbus\Http\ApiRateLimiter($db))->prune(24 * 3600);
            echo "nb_api_rate: removed {$removed} stale row(s).\n";

            // Login/reset throttle rows past their lock+decay window (FU-10);
            // the prune never removes a row under an active lockout.
            $throttled = (new Nimbus\Auth\LoginThrottle($db))->prune(24 * 3600);
            echo "nb_login_throttle: removed {$throttled} stale row(s).\n";

            // Then every enabled plugin's retention/maintenance task.
            foreach ((new Nimbus\Application($db))->maintenanceRegistry()->all() as $task) {
                try {
                    $affected = ($task['task'])();
                    echo "{$task['name']}: {$affected} row(s).\n";
                } catch (\Throwable $e) {
                    fwrite(STDERR, "{$task['name']}: failed — {$e->getMessage()}\n");
                }
            }
            break;

        case 'token:list':
            $rows = (new Nimbus\Api\ApiTokenRepository($db))->all();
            if ($rows === []) {
                echo "No API tokens.\n";
                break;
            }
            // A role-id → name map so a bound token shows its role, not a number.
            $roleNames = [];
            foreach ((new Nimbus\Auth\RoleRepository($db))->all() as $role) {
                $roleNames[$role->id] = $role->name;
            }
            foreach ($rows as $t) {
                $role = $t->roleId !== null ? ($roleNames[$t->roleId] ?? "role #{$t->roleId}") : '—';
                printf(
                    "#%-3d %-8s %-22s role %-12s used %-5d last %s%s\n",
                    $t->id,
                    $t->status(),
                    mb_substr($t->name, 0, 22),
                    mb_substr($role, 0, 12),
                    $t->usedCount,
                    $t->lastUsedAt ?? 'never',
                    $t->expiresAt !== null ? "  expires {$t->expiresAt}" : '',
                );
            }
            break;

        case 'token:revoke':
        case 'token:pause':
        case 'token:resume':
            $id = $opt($argv, 'id');
            if ($id === null || !ctype_digit($id)) {
                fwrite(STDERR, "Usage: nimbus {$command} --id=N\n");
                exit(1);
            }
            $repo   = new Nimbus\Api\ApiTokenRepository($db);
            $action = substr($command, strlen('token:')); // revoke | pause | resume
            if (!$repo->exists((int) $id)) { // ADMIN-14b: no phantom success for a missing id
                fwrite(STDERR, "No token with id {$id}.\n");
                exit(1);
            }
            match ($action) {
                'revoke' => $repo->revoke((int) $id),
                'pause'  => $repo->pause((int) $id),
                default  => $repo->resume((int) $id),
            };
            echo "Token #{$id} {$action}d.\n";
            break;

        default:
            echo <<<TXT
            NimbusCMS

              migrate                                          run pending migrations
              prune                                            clean stale rate rows + run plugin retention (cron)
              media:reindex                                    rebuild the media-usage index from entries (one-off on upgrade)
              roles:seed                                       seed the system roles + assign users (idempotent; run on upgrade)
              mail:test <address>                              send a test email through the configured transport
              openapi                                          print the OpenAPI 3.0 spec for the live API
              mcp                                              serve MCP over stdio (JSON-RPC); needs NIMBUS_MCP_TOKEN
              install  [--email= --name= --password=]          migrate + create the admin user
              create-user --email=  [--password= --name= --role=]
              token:create --name="My app" [--expires=90d] [--scopes=posts:read,*:read] [--role=editor]
              token:list                                       show every token + its state (and bound role)
              token:revoke --id=N                              revoke a token (permanent)
              token:pause  --id=N                              temporarily disable a token
              token:resume --id=N                              re-enable a paused token

            TXT;
    }
} catch (\Throwable $e) {
    fwrite(STDERR, 'Error: ' . $e->getMessage() . "\n");
    exit(1);
}
