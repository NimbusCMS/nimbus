# Per-site runtime config — copy to deploy/sites/site-a.env (chmod 600).
APP_ENV=production
APP_DEBUG=false
APP_URL=https://site-a.example.com
DB_HOST=db
DB_NAME=site_a
DB_USER=site_a
DB_PASS=change-me-site-a
# {pinned edge Caddy IP} + {Cloudflare ranges} — so the rate limiter/audit see
# the real client IP. This is the edge's EXACT IP (docker-compose.prod.yml pins
# caddy to 172.31.7.254), NOT the /24: trusting the subnet would trust every
# sibling site as a proxy, letting a compromised site forge client IPs against
# its neighbours. And NEVER the whole docker bridge (172.16.0.0/12).
TRUSTED_PROXIES=172.31.7.254,173.245.48.0/20,103.21.244.0/22,141.101.64.0/18,108.162.192.0/18,190.93.240.0/20,188.114.96.0/20,197.234.240.0/22,198.41.128.0/17,162.158.0.0/15,104.16.0.0/13,104.24.0.0/14,172.64.0.0/13,131.0.72.0/22
# Demo mode: a public, shared, periodically-reset sandbox. Off unless set. When
# on, the admin shows a "live demo" banner and change-password is disabled
# (enforced server-side). Only for a throwaway demo site — never a real install.
# NIMBUS_DEMO=true
