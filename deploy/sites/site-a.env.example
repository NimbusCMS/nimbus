# Per-site runtime config — copy to deploy/sites/site-a.env (chmod 600).
APP_ENV=production
APP_DEBUG=false
APP_URL=https://site-a.example.com
DB_HOST=db
DB_NAME=site_a
DB_USER=site_a
DB_PASS=change-me-site-a
# {pinned web subnet} + {Cloudflare ranges} — so the rate limiter/audit see the
# real client IP. NEVER the whole docker bridge (172.16.0.0/12).
TRUSTED_PROXIES=172.31.7.0/24,173.245.48.0/20,103.21.244.0/22,141.101.64.0/18,108.162.192.0/18,190.93.240.0/20,188.114.96.0/20,197.234.240.0/22,198.41.128.0/17,162.158.0.0/15,104.16.0.0/13,104.24.0.0/14,172.64.0.0/13,131.0.72.0/22
