# Platform secrets — copy to deploy/.env (chmod 600), never commit.
MYSQL_ROOT_PASSWORD=change-me-strong-root
# Cloudflare edge ranges (space-separated) — refresh from https://www.cloudflare.com/ips/
CLOUDFLARE_RANGES=173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
# Per-site DB + user (each user is scoped to its own schema only)
SITE_A_DB=site_a
SITE_A_USER=site_a
SITE_A_PASS=change-me-site-a
SITE_B_DB=site_b
SITE_B_USER=site_b
SITE_B_PASS=change-me-site-b
