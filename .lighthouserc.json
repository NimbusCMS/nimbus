{
  "ci": {
    "collect": {
      "url": [
        "http://127.0.0.1:8099/",
        "http://127.0.0.1:8099/blog/sample-post-1",
        "http://127.0.0.1:8099/blog?page=2"
      ],
      "numberOfRuns": 3,
      "settings": {
        "onlyCategories": ["performance"]
      }
    },
    "assert": {
      "assertions": {
        "resource-summary:script:size": ["error", { "maxNumericValue": 10240 }],
        "resource-summary:document:size": ["error", { "maxNumericValue": 51200 }],
        "resource-summary:stylesheet:size": ["error", { "maxNumericValue": 51200 }],
        "resource-summary:total:size": ["error", { "maxNumericValue": 204800 }],
        "resource-summary:third-party:count": ["error", { "maxNumericValue": 0 }],
        "categories:performance": ["warn", { "minScore": 0.9 }],
        "first-contentful-paint": ["warn", { "maxNumericValue": 2000 }],
        "largest-contentful-paint": ["warn", { "maxNumericValue": 2500 }],
        "cumulative-layout-shift": ["warn", { "maxNumericValue": 0.1 }],
        "total-blocking-time": ["warn", { "maxNumericValue": 200 }]
      }
    },
    "upload": {
      "target": "temporary-public-storage"
    }
  }
}
